[{"id": 119749, "title": "湾区升明月 2024大湾区电影音乐晚会", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240923-1/59df2421a996c98b94d8a5c799f6a4d9.webp", "year": "2024", "area": "中国大陆", "actor": "成龙 / 任达华 / 肖战 / 于适", "director": "", "content": "", "episodes": [{"name": "HD", "url": "https://v11.wujinwsym3u8.com/wjv11/202409/23/AgSGJnV0RW83/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 118492, "title": "山歌响起的地方刀郎知交线上演唱会", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240831-1/e5a39cc52e71a955885c93c5a2990403.jpg", "year": "2024", "area": "中国大陆", "actor": "刀郎", "director": "刀郎", "content": "<p>与半个多亿的听众朋友一起共赴一场音乐会，这真是前所未有、进入吉尼斯记录的一次超级享受，我不知道除了刀郎，谁还有这么大的影响力？将来又会有谁，来破这个世界纪录？今晚，“山歌响起的地方：刀郎知交线上演唱会”，在他的家乡四川资中举行，距离演唱舞台几百米的地方，就是刀郎的幼儿园、小学、中学，这是他献给河流山川的歌，献给家乡父老的歌，也是献给青春少年的歌，其中的感情，浓得可以感到怎么也化不开！</p>", "episodes": [{"name": "HD", "url": "https://v2.wujinwsym3u8.com/wjv2/202408/31/JsCDaKyiL174/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75950, "title": "黄子华栋笃笑之洗燥", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/90cd257768e03bb925b53579a655037d.jpg", "year": "2012", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "", "episodes": [{"name": "HD", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/Jj6wmFR1B31/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75941, "title": "唔痴线唔正常", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/44a7444ca085a199c6165a46e40edd5d.jpg", "year": "2014", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/wPPb1Ad8Rq1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75942, "title": "黄子华栋笃笑之金盆", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/a1424607fbd5aae96611e3e7b1571b66.jpg", "year": "2018", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>黃子華棟篤笑之金盤??口</p>", "episodes": [{"name": "HD", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/cp2da8eP1q1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75940, "title": "越大镬越快乐", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/8797eeab12137f154d37c0559d74e85c.jpg", "year": "2007", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>这次表演围绕几个常见的哲学课题来做文章：人生的意义、社会的不公、道德的反思、消费主义的荒谬、如何释放自我等。借与投资经理的对话、失去手脚的乞丐、为朱局长抱不平、樽装水的定价及互联网崛起的题来发挥，每个话题均予人多层次的思考空间，一环扣一环。虽然距离上次演出只有短短一年，但亦可见创作过程中，创作者如何把不同的题目抽丝剥茧，去芜存菁，把最精采的留给观众。</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/SyZUR5ffft1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75936, "title": "须根ShowⅡ", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/20b163e4db876ad6d085f9091d2d5860.jpg", "year": "2000", "area": "中国香港", "actor": "黄子华,吴镇宇,张达明", "director": "黄子华", "content": "<p>须根一族，故名思义，所指的是那些妄顾仪容，无论出席大小场合都是一脸须根的男人。\r\n　　在外型如此重要和电须刨如此普遍的年代，须根一族还是依然故我，可见他们是如何具有性格的一个特别族群。\r\n　　须根，代表了反科技，反中产，反整洁，反时装，也代表了大男人，大中华，大笪地，大大声，而最重要，须根一族，代表了大部份的男人!</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/UzsryYy9ny1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75937, "title": "黄子华栋笃笑之冇炭用", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/be3591abbe2ee559d8f04e6cd2153237.jpg", "year": "2003", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>黄子华栋笃笑系列的第八辑。\r\n　　场目\r\n　　﹡黄子华冇炭用前传\r\n　　01、开场白\r\n　　02、陀衰家\r\n　　03、破产\r\n　　04、失业\r\n　　05、自杀\r\n　　06、大学生\r\n　　07、老人家\r\n　　08、减肥\r\n　　09、成年人\r\n　　10、董建华\r\n　　11、从来不是天堂\r\n　　12、传媒笑系列的第八辑。</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/d6b5Xkeie81/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75938, "title": "娱乐圈血肉史2", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/c8b0cdd404c1e7ca40cc1a311c3dbeec.jpg", "year": "2011", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "", "episodes": [{"name": "第01集", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/5djNr2Dvm61/video/index.m3u8"}, {"name": "第02集", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/6hxwHtRkQP1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75939, "title": "哗众取宠", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/75b5b2db97cb9fb3059408d04edb726e.jpg", "year": "2009", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>场目\r\n　　01. 回水歌\r\n　　02. 金融海啸\r\n　　03. 孔明\r\n　　04. 红楼梦\r\n　　05. 机场阿婶\r\n　　06. 巴黎黛玉\r\n　　07. 忍\r\n　　08. 地下婚礼\r\n　　09. 可乐\r\n　　10. 卫生巾\r\n　　11. 生发水\r\n　　12. 眼部激光\r\n　　13. 破产\r\n　　14. 名表\r\n　　15. 风光大葬\r\n　　16. 天真\r\n　　17. 时代变了\r\n　　18. 自我放送\r\n　　19. 七步成诗\r\n　　20. 老婆们\r\n　　21. 三刀六眼\r\n　　22. 七步Sound Track</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/dkhSkqvmTt1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75930, "title": "黄子华栋笃笑双打之玩无可玩", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/cfaec1e14e7d3619797b6762cd3b5cd6.jpg", "year": "1995", "area": "中国香港", "actor": "黄子华,张达明", "director": "黄子华", "content": "<p>于1995年10月在于香港伊利沙伯体育馆公演，黄子华栋笃笑系列的第五辑。与张达明合作。</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/kZNE2KF7t61/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75931, "title": "秋前算账", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/a0e37cdc043c713e84842433c004549b.jpg", "year": "1997", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>栋笃笑《秋前算账》于1997年4月10日在香港伊利沙伯体育馆首演，是黄子华栋笃笑系列的第六辑。</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/VbNeu8ztUU1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75932, "title": "黃子華棟篤笑之末世財神", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/9df703a9128de12a39d9611cb6cb1134.jpg", "year": "1994", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>黄子华栋笃笑系列的第四辑。</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/0MRD8WzPHt1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75933, "title": "黃子華栋笃笑之色情家庭", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/a6c7883d6766cf5978d6a00957c6763b.jpg", "year": "1991", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>伊馆，黄子华栋笃笑系列的第二辑。</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/z1rKTt9RAk1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75934, "title": "拾下拾下", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/6d3f08f842abe05a2d9a6668e59c1027.jpg", "year": "1999", "area": "中国香港", "actor": "黄子华", "director": "黄子华", "content": "<p>栋笃笑《拾下拾下》于1999年8月10日在香港伊利沙伯体育馆首演，是黄子华栋笃笑系列的第七辑。</p>", "episodes": [{"name": "HD", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/ZmvWYtrStj1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75935, "title": "须根Show", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/40a26ce54f79323369c95b5f9f9af2fe.jpg", "year": "1998", "area": "中国香港", "actor": "黄子华,吴镇宇,张达明", "director": "黄子华", "content": "<p>须根一族，故名思义，所指的是那些妄顾仪容，无论出席大小场合都是一脸须根的男人。\r\n　　在外型如此重要和电须刨如此普遍的年代，须根一族还是依然故我，可见他们是如何具有性格的一个特别族群。\r\n　　须根，代表了反科技，反中产，反整洁，反时装，也代表了大男人，大中华，大笪地，大大声，而最重要，须根一族，代表了大部份的男人!</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/J1cbqtPuC01/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 75929, "title": "跟住去边度", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/c9f9fef3ac699685055e82baa048fe76.jpg", "year": "1992", "area": "中国香港", "actor": "黄子华", "director": "黃子華", "content": "<p>黄子华的三集栋笃笑，分别涉猎过破碎家庭、成长与性、娱乐圈的残酷与辛酸、搔到痒处的政治实况。题材从个人推展至社群国家。\r\n　　“每次选嘅题材一定系我好有感受嘅，呢个系我嘅最大原则。唔一定发生喺我身上，或者发生喺你身上，但我好有感受，就会讲。”\r\n　　他转了坐姿，说自己是没有使命感的人，例如《跟住去边度？》讲政治，是觉得自己有时真的活得好像一只狗，有些许解释人类生存状况。“问我点解咁做？我都唔知嘎，呢D系创作嘅冲动，等于我点解饮好立克，点解钟意女人一样。”</p>", "episodes": [{"name": "中字", "url": "https://v5.wujinwsym3u8.com/wjv5/202310/14/6n21jxqg0V1/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 72960, "title": "小杨臻选群星演唱会", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/c929a8d5085e1556d86dc8cb537db767.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>小杨臻选群星演唱会</p>", "episodes": [{"name": "HD", "url": "https://v3.wujinwsym3u8.com/wjv3/202311/27/C0LC2nYYZ32/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 67860, "title": "邓丽君1982伊丽莎白体育馆演唱会", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/fd6024bc4feee5cf6e06037d9a15b7cd.jpg", "year": "1982", "area": "中国香港", "actor": "邓丽君", "director": "", "content": "", "episodes": [{"name": "HD", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/23/XqeYXFdgyN2/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 67861, "title": "邓丽君香港利舞台演唱会1976", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/52c3adc570fc26e626f1c94795d1d355.jpg", "year": "1976", "area": "中国香港", "actor": "邓丽君", "director": "", "content": "", "episodes": [{"name": "HD", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/23/LQ7XfkgC4V2/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 67862, "title": "邓丽君：十五周年香港巡回演唱会1983", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/c2a0c5710bcf1e36dfbc262e38341dde.jpg", "year": "1983", "area": "中国香港", "actor": "邓丽君", "director": "", "content": "", "episodes": [{"name": "HD", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/23/CQVvaVutdw2/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}, {"id": 64760, "title": "阿黛尔伦敦爱尔伯特音乐厅演唱会", "category": "演唱会", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/c01d9d6c6fec967ed52de5fc43a9b7fd.jpg", "year": "2011", "area": "英国", "actor": "阿黛尔", "director": "Paul,Dugdale", "content": "<p>Adele将那些心碎的回忆，化为纠结人心的浪漫旋律，从自弹自唱的宅女摇身一变成为叱吒风云的流行女王。2011年9月22日，Adele首度登上全球歌者的终极圣殿——英国伦敦皇家爱尔伯特音乐厅，《Live At The Royal Albert Hall》完整记录了这一票难求的演唱会完整实况。\r\n　　全场曲目列表如下：\r\n　　1.Hometown Glory\r\n　　2.I&#39;ll Be Waiting\r\n　　3.Don&#39;t You Remember\r\n　　4.Turning Tables\r\n　　5.Set Fire To The Rain\r\n　　6.If It Hadn&#39;t Been For Love\r\n　　7.My Same\r\n　　8.Take It All\r\n　　9.Rumour Has It\r\n　　10.Right As Rain\r\n　　11.One &amp; Only\r\n　　12.Lovesong\r\n　　13.Chasing Pavem...</p>", "episodes": [{"name": "HD", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/15/atPrnnCABh4/video/index.m3u8"}], "data_file": "cat_9e27f3276e.json"}]