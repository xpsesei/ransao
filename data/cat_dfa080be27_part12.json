[{"id": 67585, "title": "一人不入庙", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/27aaf18b44376d1aaf6d9f69aaeb4faa.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>剧組深陷荒野孤村，千年古庙惊现嫁衣鬼影，同伴接连死亡，疯癫老头口中的轮回背后到底隐藏了怎样的秘密！</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/25/crhwGfDGrZ2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/25/5syjc6G7JT2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/25/G9kKMkJXrm2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/25/qyzubZt9Vf2/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 67540, "title": "凶宅诡事录", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/37a92980777eb3cd6f22d3936dfca8f2.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>京城才女阔少收到神秘邀約，集合地竟是千年凶宅！古宅探险，同伴皆七孔流血离奇死亡！鬼打墻、古宅魅影，凶宅背后到底隱藏了什么秘密！</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/0Ctf9H0GAU2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/v7VXTrsTT72/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/g2xBKxxc7F2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/2ZRgcVbYJf2/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 67537, "title": "独断万古", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/7879b66dc806415447c9429e7bc8f724.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>父母被害失踪，自己妻子被逼离开，男主心里怒火滔天，但却势单力薄，被废掉四肢扔在乱葬岗！却没想到，鲜血染红龙尸，意外获得龙骨传承，从此蛟龙化凡！开启逆天狂霸之路！</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/baZXR2byCQ2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/3zJARG7Znp2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/UyG1CNKgwa2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/kn8prvWESJ2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/27/hfMP63cq422/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 67345, "title": "缘起", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/079cbc07f50b4a6ca44a0cfd85750fae.jpeg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>念你我一夜肌肤之亲，我愿为你夺下神州！缘起</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/hwWuMh0k6x2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/67f0Xaeevh2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/fygR5Czd1V2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/J4uuqPrJkf2/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 67343, "title": "界王神君", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/f736cde910cb853bbdfc6f9b4712fef5.jpeg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>天大地大我最大，神界之王再次降临，请献上你们的膝盖！</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/ZFrmpiEX002/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/LZZpNJppvt2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/71n2ff6qsi2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202401/30/7zcqrmySFv2/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 67179, "title": "仙帝归来", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/f81829c04847d0a40087189fcca4e72c.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>万年以來魔族一直被仙族镇压，沒想到今日仙帝手下竟背叛与魔王一同进攻仙帝！仙帝一缕魂魄逃至下界，还成了个修真界的废柴师弟？我要重新修练报仇</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/02/J2rDJ6YpHE2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/02/TiBN2Jz0aG2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/02/nwFNEMHnEB2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/02/06V7tJX4y52/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 66311, "title": "天命神算", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/d6a02948dc7f93ccc188c7643de494c4.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>在一个被古老诅咒笼罩的夜晚，传说中的天命仙子的后裔黄家姑娘，意外发现了自己不凡的命运。在祖传的古董箱中，她找到了一本尘封的天书，揭开了一个千年不解的谜团</p>", "episodes": [{"name": "全集", "url": "https://v3.wujinwsym3u8.com/wjv3/202404/19/YFWBcCaYRv75/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 66310, "title": "九天龙帝", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/0e5dd0bac8e86b15e536603fa0b9038e.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p><span style=\"text-wrap: wrap;\">他诛魔将，武功盖世，赐大夏真龙帝位。现在却在这里当一个猪肉佬，只因为他不想再卷入纷争，只想云游四方，事情却没那么简单。。。</span></p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/21/3QkkVYy2YJ2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/21/zvWvdU3u7K2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/21/VqBmFKvTuT2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/21/ku9KRce2Ru2/video/index.m3u8"}], "data_file": "cat_dfa080be27_part12.json"}, {"id": 65705, "title": "凡士龙心", "category": "脑洞悬疑", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/62b14fe1ca89ddbe9848b3d340ac2d3e.jpg", "year": "2023", "area": "内地