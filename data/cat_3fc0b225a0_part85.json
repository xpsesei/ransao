[{"id": 165, "title": "仙剑奇侠传", "category": "国产剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20210625-1/24041fa3210bf61f38851e78a086fb11.jpg", "year": "2005", "area": "中国大陆", "actor": "胡歌,刘亦菲,安以轩", "director": "吴锦源,梁胜权,麦贯之", "content": "<p>《仙剑奇侠传》改编自PC游戏史上最为经典的游戏作品。一心习武梦想名震江湖的李逍遥(胡歌 饰)，为求灵丹妙药救助忽患怪病相依为命的李大婶上了仙岛，在机缘巧合下结识神秘少女赵灵儿(刘亦菲 饰)。两人情投意合当日就成婚，并许诺永不相忘。遥带着金丹离岛救婶婶，却被骗服下“忘忧散”，把与灵儿的一切全部忘记！已身怀有孕的灵儿深受打击，又发现自己是“大地之母”女娲后人的真相，有着拯救苍生的使命只好忍痛放下私人感情！逍遥在行走江湖的途中结识了刘晋元及其外刚内柔的表妹妹林月如(安以轩 饰)，并渐渐和这个欢喜冤家产生了情愫。李逍遥的感情到底何去何从？作为女娲后人的赵灵儿又背负着怎样的命运？一路上的诡异事件又预示着如何饿结局？</p>", "episodes": [{"name": "第01集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/nhP0hfYc4X1/video/index.m3u8"}, {"name": "第02集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/rvTTGEQjv91/video/index.m3u8"}, {"name": "第03集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/6nepxanhWV1/video/index.m3u8"}, {"name": "第04集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/8fBTmtgcCm1/video/index.m3u8"}, {"name": "第05集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/WT6Q9q9ME11/video/index.m3u8"}, {"name": "第06集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/wJNe2i5JfU1/video/index.m3u8"}, {"name": "第07集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/1i56krmdfh1/video/index.m3u8"}, {"name": "第08集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/jqXswWUpNW1/video/index.m3u8"}, {"name": "第09集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/CvX2Qnn3tw1/video/index.m3u8"}, {"name": "第10集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/9F9QD71R3B1/video/index.m3u8"}, {"name": "第11集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/SQtViyYLp51/video/index.m3u8"}, {"name": "第12集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/jAGyMvE16L1/video/index.m3u8"}, {"name": "第13集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/36arBb8Uqs1/video/index.m3u8"}, {"name": "第14集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/SVY6CtZgrR1/video/index.m3u8"}, {"name": "第15集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/mwSEmTW4x41/video/index.m3u8"}, {"name": "第16集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/yurPFudsL11/video/index.m3u8"}, {"name": "第17集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/CRUsrURdpt1/video/index.m3u8"}, {"name": "第18集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/5kCCFsQA101/video/index.m3u8"}, {"name": "第19集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/KyAf2vPLwD1/video/index.m3u8"}, {"name": "第20集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/xW3B6DMHAC1/video/index.m3u8"}, {"name": "第21集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/aU1twHDRrb1/video/index.m3u8"}, {"name": "第22集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/jyBXrCm1aQ1/video/index.m3u8"}, {"name": "第23集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/m9JEbCYGtn1/video/index.m3u8"}, {"name": "第24集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/2uZ8LRBqtj1/video/index.m3u8"}, {"name": "第25集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/Ewf5zrYcfA1/video/index.m3u8"}, {"name": "第26集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/DAKtFVp5Wr1/video/index.m3u8"}, {"name": "第27集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/zxKcZaUjPR1/video/index.m3u8"}, {"name": "第28集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/m2rBuzt21M1/video/index.m3u8"}, {"name": "第29集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/pmQV1q4em01/video/index.m3u8"}, {"name": "第30集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/sjj6F2Kd2z1/video/index.m3u8"}, {"name": "第31集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/qsuGMgR5VW1/video/index.m3u8"}, {"name": "第32集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/D9Q4RtG8vV1/video/index.m3u8"}, {"name": "第33集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/P0NgFCLkny1/video/index.m3u8"}, {"name": "第34集", "url": "https://v9.wujinwsym3u8.com/wjv9/202309/07/JY1YmmNnrX1/video/index.m3u8"}], "data_file": "cat_3fc0b225a0_part85.json"}, {"id": 151, "title": "陪你到世界终结", "category": "国产剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/046ebe2566c9aaf7c2ed2237b9c11d62.jpg", "year": "2021", "area": "中国大陆", "actor": "肖雨,张耀,周也", "director": "于光中", "content": "<p>根据小说《三年K班》改编。17岁的京芷卉因为一次交通意外导致分班考失利进入了学习氛围较差的高三十一班，京芷卉多次尝试离开十一班都最终失败，只得将目标转向了优秀学生干部的高考加分，并为此设定了获取全班同学信任的攻略计划，原本抱着功利目的与同学接触的京芷卉却渐渐在同学们身上发现了各种优质品质，经过数次欢笑与泪水后，京芷卉开始渐渐融入到十一班的集体之中，十一班渐渐改变了吊尾班的命运，大家顺利完成高考进入各自理想大学，留下一段难以忘怀的青春记忆。</p>", "episodes": [{"name": "第01集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/tbsSLrwh0p1/video/index.m3u8"}, {"name": "第02集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/zsgCsZWsBM1/video/index.m3u8"}, {"name": "第03集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/E5QEG3NJgq1/video/index.m3u8"}, {"name": "第04集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/N8HKS6nLRp1/video/index.m3u8"}, {"name": "第05集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/mUj3YpMTap1/video/index.m3u8"}, {"name": "第06集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/SrVTFQmwHL1/video/index.m3u8"}, {"name": "第07集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/FC32vRvXCb1/video/index.m3u8"}, {"name": "第08集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/vQ9ndmdT4U1/video/index.m3u8"}, {"name": "第09集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/mV8BhjbwnY1/video/index.m3u8"}, {"name": "第10集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/bdD2XGvK6M1/video/index.m3u8"}, {"name": "第11集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/yHFsGstFfJ1/video/index.m3u8"}, {"name": "第12集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/yb574tEZSi1/video/index.m3u8"}, {"name": "第13集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/5V2UWFQQ8i1/video/index.m3u8"}, {"name": "第14集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/2Fk2GKUviS1/video/index.m3u8"}, {"name": "第15集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/2vtGKbqdY71/video/index.m3u8"}, {"name": "第16集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/FCBuVg2kCT1/video/index.m3u8"}, {"name": "第17集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/3bbvyREdej1/video/index.m3u8"}, {"name": "第18集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/8LA8iSriF11/video/index.m3u8"}, {"name": "第19集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/cVQ6sJ25Zd1/video/index.m3u8"}, {"name": "第20集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/MR0f9Nucuk1/video/index.m3u8"}, {"name": "第21集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/XwRVByRRvN1/video/index.m3u8"}, {"name": "第22集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/XjWhCMGrGM1/video/index.m3u8"}, {"name": "第23集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/h4txzRc9xr1/video/index.m3u8"}, {"name": "第24集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/4MsrifGfZA1/video/index.m3u8"}, {"name": "第25集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/TJStdEq7BJ1/video/index.m3u8"}, {"name": "第26集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/yDvypZvejV1/video/index.m3u8"}], "data_file": "cat_3fc0b225a0_part85.json"}, {"id": 133, "title": "潜伏2009", "category": "国产剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/ef458bdf1a4649f1cefd163faf500c0a.jpg", "year": "2009", "area": "中国大陆", "actor": "孙红雷,姚晨,沈傲君", "director": "姜伟,付玮", "content": "<p>1945年，正是抗日战争接近尾声之际，国、共、日三方的角力日趋激烈，平静的海面下暗流涌动。由于军统特务李海丰投靠南京汪伪政权，军统情报处成员余则成（孙红雷 饰）受命前往南京刺杀叛徒，却意外走上了另一条道路。经中共策反，余则成以地下党的身份重返军统，成为扎入国民党心脏的一颗铆钉。为了协助余的工作，党组织派出脾气火爆、口无遮拦的女孩翠平（姚晨 饰）担任余的冒牌夫人。随着时间的推移，国共的斗争愈加强烈，这对夫妇也面临着人生重大的考验……本片根据天津作家龙一（本名李鹏）的同名短篇小说改编，并荣获第15届上海电视节“白玉兰奖”电视剧最佳男演员奖（孙红雷）、第27届飞天奖优秀男演员奖、2010年第25届中国电视金鹰奖观众喜爱的女演员奖（姚晨）。</p>", "episodes": [{"name": "第01集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/Fm4Z8aL3271/video/index.m3u8"}, {"name": "第02集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/pjeg3PkuC51/video/index.m3u8"}, {"name": "第03集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/s7uT33b0ru1/video/ind