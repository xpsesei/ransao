8/hn6r9Qg3WY8/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 109867, "title": "我被系统关了十万年", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240411-1/4287437f3a590acf419e8dab2ebe6e3a.webp", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>穿越就被关十万年，出世是最强剑神，无敌老祖现身开启慢慢修仙路</p>", "episodes": [{"name": "全集", "url": "https://v12.wujinwsym3u8.com/wjv12/202404/08/buY4tLfPTX8/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 109864, "title": "重生80年代娶媳妇", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240411-1/7db827e1e15b4eab3cc9d351fe9562c8.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>重回80年代娶妻，大伯在我结婚前一天把我老婆弄脏了，我重生回来寻找他的复仇。</p>", "episodes": [{"name": "全集", "url": "https://v9.wujinwsym3u8.com/wjv9/202404/09/h30Yt4hRF818/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 109861, "title": "江南警察局", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240411-1/7751dcc4b6b970ecc26b7ce33065ccd2.jpg", "year": "2024", "area": "大陆", "actor": "", "director": "", "content": "<p>最新热门沙雕动画！警察的职业你了解多少，在强权面前永不不低头。</p>", "episodes": [{"name": "全集", "url": "https://v9.wujinwsym3u8.com/wjv9/202404/09/cB09Yxa5CC18/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 109840, "title": "陆游讫寻亲记", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240411-1/3911ef59d5e995688c7d9926c5c9b61c.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>重生回到90年代，开启寻亲之旅！</p>", "episodes": [{"name": "全集", "url": "https://v12.wujinwsym3u8.com/wjv12/202404/09/7EVzkEtRaL8/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 109839, "title": "阿宝末世求生记", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240411-1/f7c1ade41311c49903d9edf541da3d3f.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>末世我花一百万买只土狗，只因我想和它做朋友，末世爆发，从复仇开始，异能觉醒永远不会迟到。</p>", "episodes": [{"name": "全集", "url": "https://v12.wujinwsym3u8.com/wjv12/202404/09/ah7ikx5V7J8/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 109834, "title": "绝情师尊，三位女帝", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240411-1/4a8bd7c52c79cb147c4b5821f13255fb.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>被视作十恶不赦的我，却被七女帝徒绝儿联手封印</p>", "episodes": [{"name": "全集", "url": "https://v9.wujinwsym3u8.com/wjv9/202404/09/tqcxd1L7pb18/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}, {"id": 63172, "title": "我的暴富系统", "category": "有声动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/eb55707e55e77f319fff98147c5a31ab.webp", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>婚后，我意外激活系统，余额多了一个亿！</p>", "episodes": [{"name": "全集", "url": "https://v11.wujinwsym3u8.com/wjv11/202404/08/s4CqpNm2MV3/video/index.m3u8"}], "data_file": "cat_e7fe1ef9ec.json"}]