[{"id": 124, "title": "明日传奇第五季", "category": "美国剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/a1fd2d3d4c74a064a70b5e0eaef10284.jpg", "year": "2020", "area": "美国", "actor": "布兰登·罗斯,凯蒂·洛茨,艾米·彭伯顿", "director": "大卫·盖迪斯,格里高利·史密斯,亚历山德拉·拉罗什", "content": "<p>CW台一口气宣布续订旗下10部美剧，刚刚庆祝播出300集的《邪恶力量》续订第15季，收视稳定的超级英雄系列剧集《绿箭侠》（第八季）、《黑霹雳》（第三季）、《明日传奇》（第五季）、《闪电侠》（第六季）、《女超人》（第五季）毫无悬念获得了新一季的续订。</p>", "episodes": [{"name": "第01集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/Ae5EcsUB0F2/video/index.m3u8"}, {"name": "第02集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/MRYP8UNxQq2/video/index.m3u8"}, {"name": "第03集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/DQJYbaHi1z2/video/index.m3u8"}, {"name": "第04集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/WVKKjS4set2/video/index.m3u8"}, {"name": "第05集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/qwqQDkrZmf2/video/index.m3u8"}, {"name": "第06集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/SrbBPpxnzM2/video/index.m3u8"}, {"name": "第07集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/vT0CyBmGg72/video/index.m3u8"}, {"name": "第08集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/T72Ej3p1Rk2/video/index.m3u8"}, {"name": "第09集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/sNWKUpt5ZT2/video/index.m3u8"}, {"name": "第10集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/puSTeU7bpa2/video/index.m3u8"}, {"name": "第11集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/cW4khXhWdq2/video/index.m3u8"}, {"name": "第12集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/ktA3HY3Qdm2/video/index.m3u8"}, {"name": "第13集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/n0pXWhwRiD2/video/index.m3u8"}, {"name": "第14集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/yDm3EmLhs42/video/index.m3u8"}, {"name": "第15集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/PgHCFBnNns2/video/index.m3u8"}], "data_file": "cat_3f40a58533_part29.json"}, {"id": 123, "title": "明日传奇第四季", "category": "美国剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/0c06402dcadbd0b84d88b633e5afb22f.jpg", "year": "2018", "area": "美国", "actor": "布兰登·罗斯,凯蒂·洛茨,塔拉·阿什", "director": "德莫特·唐斯,格里高利·史密斯", "content": "<p>《明日传奇》即将播出的第四季曝光预告片，从穿越去美国大西部，到遇见巨大的蓝色填充玩具，剧情脑洞大开，同时，DC漫画的魔鬼猎手康斯坦丁升为常规主演。第四季将在10月22日首播。</p>", "episodes": [{"name": "第01集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/QUH6A3BDVC2/video/index.m3u8"}, {"name": "第02集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/BJtDdMNgEc2/video/index.m3u8"}, {"name": "第03集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/8WzeSx42Aj2/video/index.m3u8"}, {"name": "第04集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/MWxdhVd90b2/video/index.m3u8"}, {"name": "第05集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/DzAN1mDPAN2/video/index.m3u8"}, {"name": "第06集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/18WxfPZPcY2/video/index.m3u8"}, {"name": "第07集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/YgWZH7mZG72/video/index.m3u8"}, {"name": "第08集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/sXQvQxn4zN2/video/index.m3u8"}, {"name": "第09集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/QRc1h1y8sk2/video/index.m3u8"}, {"name": "第10集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/U7xra17A6k2/video/index.m3u8"}, {"name": "第11集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/mj43UNZmf62/video/index.m3u8"}, {"name": "第12集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/yqhw0DaLhb2/video/index.m3u8"}, {"name": "第13集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/kZNNci4e4N2/video/index.m3u8"}, {"name": "第14集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/btF2ZiRL3M2/video/index.m3u8"}, {"name": "第15集", "url": "https://v2.wujinwsym3u8.com/wjv2/202308/22/2NShwTWJWy2/video/index.m3u8"}], "data_file": "cat_3f40a58533_part29.json"}, {"id": 122, "title": "明日传奇第三季", "category": "美国剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/97c5dee436adb32cd16a903f2a0ec90