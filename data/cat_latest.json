rector":"","content":"","episodes":[{"name":"全集","url":"https://v10.wujinwsym3u8.com/wjv10/202611/24/YXQDkJfxfb89/video/index.m3u8"}],"data_file":"cat_35cbbe42a2_part1.json"},{"id":168197,"title":"底层掌权人","category":"现代都市","pic":"https://img1.wujinwszy.vip/upload/vod/20261124-1/5a62618721140c07351df230fc8b116a.jpg","year":"2026","area":"中国大陆","actor":"刘雨昊&黄盈（黄壹壹）&闻栀","director":"","content":"","episodes":[{"name":"全集","url":"https://v11.wujinwsym3u8.com/wjv11/202611/24/33HnfNs3c788/video/index.m3u8"}],"data_file":"cat_35cbbe42a2_part1.json"},{"id":168196,"title":"破局重生，不负自己","category":"年代穿越","pic":"https://img1.wujinwszy.vip/upload/vod/20261124-1/ffd4d4215c8948198a5fc2e7441c32f9.jpg","year":"2026","area":"中国大陆","actor":"赵辰洁&盛柯杰","director":"","content":"","episodes":[{"name":"全集","url":"https://v3.wujinwsym3u8.com/wjv3/202611/24/yQLYJacLaG96/video/index.m3u8"}],"data_file":"cat_7b80b7410c_part1.json"},{"id":168195,"title":"仰天一笑","category":"喜剧片","pic":"https://img1.wujinwszy.vip/upload/vod/20261124-1/3001e7dc65444983873892196bccf1da.jpg","year":"2026","area":"中国大陆","actor":"宁小花,白凯南,贾旭明,马小媛,曹随风,陈泽宇,陆思恒,侯林林,陈凯欣,黄婷,陈玥安","director":"秦教授","content":"<p>一个冒牌杀手，四个半吊子队友，四车军火。 1945年上海，日本投降，日军仓库里那批军火成了各方眼热的肥肉。 混混吕一笑顶着传奇杀手“降魔杵”的名头接下活儿，手下只有造假钞的、做贼的、当逃兵的、唱戏的，凑不出一副底牌。军火未动，各方伸手：军统科长陈暮桥暗中等收网，汉奸丁通带伪军追咬，唯有商人康先生肯出钱出力。 假证件、假军服、假夫妻，一关关哄过去。 车出城那晚，各路人都到了。有人放水，有人收网，有人开枪。军火去了哪？真降魔杵是谁？</p>","episodes":[{"name":"HD","url":"https://v5.wujinwsym3u8.com/wjv5/202611/24/R0yrDugtmi96/video/index.m3u8"}],"data_file":"cat_5086e3afc3_part1.json"},{"id":168194,"title":"我爱上了一个杀人犯","category":"泰剧","pic":"https://img1.wujinwszy.vip/upload/vod/20261124-1/4cb78c96213ce86e26c1dd8569f4528f.jpg","year":"0","area":"","actor":"","director":"","content":"","episodes":[{"name":"第01集","url":"https://v8.wujinwsym3u8.com/wjv8/202611/23/TpFgGphpE786/video/index.m3u8"}],"data_file":"cat_9e7a40dbaa_part1.json"},{"id":168193,"title":"11月23日 26-27赛季NBA常规赛 步行者VS尼克斯","category":"篮球","pic":"https://img1.wujinwszy.vip/upload/v