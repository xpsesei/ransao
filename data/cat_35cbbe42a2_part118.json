[{"id": 58574, "title": "我的白眼狼女儿", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20231217-1/4ae1e3c9538d671398d9b2209878a76e.jpg", "year": "2023", "area": "中国大陆", "actor": "", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v11.wujinwsym3u8.com/wjv11/202404/13/gQT04UrNAn83/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 58531, "title": "迟欢似是顾人来", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20231216-1/71a6ce7a0d7521d28604b26b28e95626.jpg", "year": "2023", "area": "中国大陆", "actor": "", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v11.wujinwsym3u8.com/wjv11/202404/13/5s60A75Rxb83/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 58442, "title": "美女总裁欠我赊刀债", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20231215-1/7f49885423a2ed184395b264fc1be8ae.jpg", "year": "2023", "area": "中国大陆", "actor": "", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v9.wujinwsym3u8.com/wjv9/202404/16/PUAXp4iAjK81/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 52410, "title": "全资进组", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260405-1/2db5353d57ce64d131e37eeb6cdf91f8.jpg", "year": "2023", "area": "中国大陆", "actor": "陈腾跃,屈梦汝,邓诗韵,蔡卓宜,杨志雯,陈婧旸,罗予彤,邹思扬,梦汐,高维蔓,关博,权沛伦,仟承 ,许焱磊,刘星麓,慕琳哪 ,李丰蔚", "director": "巴晨旭", "content": "<p>《全资进组》讲述了一个天马行空的资方爸爸全资进组，为了完成自己各种古装大男主的梦想疯狂改剧本，导致剧情直线横跳。卑微倔强的编剧无力反抗，顶着越来越秃的头发使出浑身解数拼命填坑，各种反套路火力全开。风格彻底失控，人设反复崩塌。从宅斗到悬疑，从悬疑到仙侠，从仙侠到武林，从武林到宫廷，从宫廷到穿越……打破次元壁，各种国产古装剧类型欢聚一堂，题材开会。在他们的努力下：仙侠剧将首次从地理学大陆板块硬核打开；冰块脸男主的元神真的是一块万年玄冰；勾心斗角的宫廷剧变得异常融洽姐妹情深；锦衣卫办案悬疑感满满找了全剧也没找到凶手；白面书生赶考路上被富家千金风险投资意外称霸武林；精分男狐正邪同体切换女捉妖师难敌魅惑因爱生恨；甚至男主的朋友来探班带的爱犬为了加戏出镜也直接成了精，还给加了感情线……但在所有人都觉得这是一场闹剧的背后，你会发现他是一位演员对梦想歇斯底里的追求和...</p>", "episodes": [{"name": "全集", "url": "https://v4.wujinwsym3u8.com/wjv4/202604/04/fqF1dsAVNi95/video/index.m3u8"}, {"name": "第01集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/ALqF6PUuyM1/video/index.m3u8"}, {"name": "第02集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/3cjHJjtJEJ1/video/index.m3u8"}, {"name": "第03集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/GRsJ52nUGc1/video/index.m3u8"}, {"name": "第04集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/0VrtViJAGR1/video/index.m3u8"}, {"name": "第05集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/BzUukksNhS1/video/index.m3u8"}, {"name": "第06集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/h2AiPaZ0DQ1/video/index.m3u8"}, {"name": "第07集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/PDCvXUqmGD1/video/index.m3u8"}, {"name": "第08集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/WpTeF8Tew81/video/index.m3u8"}, {"name": "第09集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/0NuNQQfD9s1/video/index.m3u8"}, {"name": "第10集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/HTeWUaWdRP1/video/index.m3u8"}, {"name": "第11集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/mU5J8H4jqx1/video/index.m3u8"}, {"name": "第12集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/4W6UQjZUHX1/video/index.m3u8"}, {"name": "第13集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/hKPaaZAdug1/video/index.m3u8"}, {"name": "第14集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/XSKXuXH80B1/video/index.m3u8"}, {"name": "第15集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/bDTWDeMgzc1/video/index.m3u8"}, {"name": "第16集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/6HXRbpTyHe1/video/index.m3u8"}, {"name": "第17集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/6wJZc9AF1y1/video/index.m3u8"}, {"name": "第18集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/4vDGk8RFLM1/video/index.m3u8"}, {"name": "第19集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/yqLXFimtUm1/video/index.m3u8"}, {"name": "第20集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/tSAv8JGAke1/video/index.m3u8"}, {"name": "第21集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/WyjV31Q5hB1/video/index.m3u8"}, {"name": "第22集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/fBcGKgvJ7s1/video/index.m3u8"}, {"name": "第23集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/Azhs7Vf4Xm1/video/index.m3u8"}, {"name": "第24集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/27/vK4fpybiqJ1/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 50896, "title": "归路", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20261025-1/713c7c321003161f243ce8963e015b79.jpg", "year": "2023", "area": "中国大陆", "actor": "井柏然,谭松韵,李岷城,张柏嘉,王皓,张乔耳,许榕真,梁天,吴玉芳,宋宁峰,郭笑天,刘陆,张恩硕,沙宝亮,海铃,李墨之,郑家彬,龚毅星,薛宇槟,贺镪,吴承泽,孙雅丽,苏鑫,李思奇,宋一雄,龚锐,杭一帆,陆宇鹏", "director": "余翠华", "content": "<p>该剧根据墨宝非宝的同名小说改编。讲述了投资总监归晓十年后重逢排爆特警路炎晨，两人破镜重圆，找回忠诚和信仰的归途之路的故事。 归晓（谭松韵 饰）与路炎晨（井柏然 饰）是彼此的初恋，大学毕业路炎晨远赴他乡成为一名特警，同时归晓家庭遭遇变故，二人的爱情无疾而终。十年后二人归晓和路炎晨重逢，发现压抑不住对彼此的思念，重新靠近了对方。但父母给路炎晨安排婚约的消息令归晓心神不宁，路炎晨果断做出了选择，归晓明白自始至终他心中只有自己，两人再续前缘，登记结婚。婚后，路炎晨在一次任务中受伤陷入昏迷。怀孕的归晓赶去路炎晨身边，在路炎晨守护了十年的边疆城市生下了女儿。一家三口平安团聚，生活美满幸福。</p>", "episodes": [{"name": "全集", "url": "https://v10.wujinwsym3u8.com/wjv10/202610/24/wZD6rbTtZe95/video/index.m3u8"}, {"name": "第01集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/N4nSupjf941/video/index.m3u8"}, {"name": "第02集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/XG3skTw4bf1/video/index.m3u8"}, {"name": "第03集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/MtvYZiay1L1/video/index.m3u8"}, {"name": "第04集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/YRSAiJt2FS1/video/index.m3u8"}, {"name": "第05集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/9m0BcDAYv51/video/index.m3u8"}, {"name": "第06集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/sJnq5tKdBm1/video/index.m3u8"}, {"name": "第07集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/hJVwhggA9u1/video/index.m3u8"}, {"name": "第08集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/Mzs72CEPps1/video/index.m3u8"}, {"name": "第09集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/KQXfsjq3DM1/video/index.m3u8"}, {"name": "第10集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/05/yBrEyima3Y1/video/index.m3u8"}, {"name": "第11集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/pkZDuLpUaq1/video/index.m3u8"}, {"name": "第12集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/yjNCC4XUYK1/video/index.m3u8"}, {"name": "第13集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/sAiBswvzHN1/video/index.m3u8"}, {"name": "第14集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/q6REBXdJwR1/video/index.m3u8"}, {"name": "第15集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/Kc2qbjixZt1/video/index.m3u8"}, {"name": "第16集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/5SDY5tuwc11/video/index.m3u8"}, {"name": "第17集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/UwJddKZMnn1/video/index.m3u8"}, {"name": "第18集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/pUNjZ29Yb91/video/index.m3u8"}, {"name": "第19集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/THi2dd7q9E1/video/index.m3u8"}, {"name": "第20集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/c01XEcdgtS1/video/index.m3u8"}, {"name": "第21集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/dNDi78emAD1/video/index.m3u8"}, {"name": "第22集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/aE8PQQv5uE1/video/index.m3u8"}, {"name": "第23集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/6FWSxPWdMN1/video/index.m3u8"}, {"name": "第24集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/fJbKuw3Y7s1/video/index.m3u8"}, {"name": "第25集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/07/JVJGVeK4r71/video/index.m3u8"}, {"name": "第26集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/A0SwzrSjz11/video/index.m3u8"}, {"name": "第27集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/F2uyhTTyUJ1/video/index.m3u8"}, {"name": "第28集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/x15QYZEfu41/video/index.m3u8"}, {"name": "第29集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/FACSd8uDjv1/video/index.m3u8"}, {"name": "第30集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/26/AkR9ChUf8T1/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 44724, "title": "神之手", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/c41be1d16a25eabc6db225ebdcdbcc8b.jpg", "year": "2019", "area": "日本", "actor": "椎名桔平,杉本哲太,铃木砂羽,北村有起哉,星野真里,芦名星,叶山奖之,井上肇,坂井真纪,近藤正臣", "director": "兼重淳", "content": "<p>腕利きの外科医?白川泰生（椎名桔平）のもとに、21歳の古林章太郎（葉山奨之）が診察にやって来る。章太郎は肛門がんと診断され手術の後退院するが、数カ月後に転移が判明。がんが進行し悪化するにつれ耐え難い痛みに苦しみ、回復の見込みはなくなっていった。その状況に付き添っていた伯母の晶子（坂井真紀）も精神的に追い込まれ白川に安楽死の処置を懇願。白川はそれを拒否し、章太郎に寄り添い懸命に治療を行なうも、手の施しようがなくなる。そしてついに、苦悩の末、安楽死の処置を行なう。しかし章太郎の死を知った母親でジャーナリストの康代（鈴木砂羽）により白川は告発されてしまう。\r\n　　白川の行為は殺人か過失致死かと連日取り沙汰される中、すでに議論されていた安楽死法案の成立が現実味を帯びる。その背後で日本の医療改革を企てる団体、さらに反対派の医師やマスコミを使って安楽死法案の阻止を図る...</p>", "episodes": [{"name": "全集", "url": "https://v8.wujinwsym3u8.com/wjv8/202606/28/1u8e60PPz789/video/index.m3u8"}, {"name": "第01集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/85d3Nw5Y882/video/index.m3u8"}, {"name": "第02集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/c12cNNdqvm2/video/index.m3u8"}, {"name": "第03集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/rTQ4d3eYi12/video/index.m3u8"}, {"name": "第04集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/JT63xUyVkS2/video/index.m3u8"}, {"name": "第05集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/iPvVMJYTsx2/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 37202, "title": "逃学威龙", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260402-1/87d9d65eacdadbf0bb3dd95f9a96c698.jpg", "year": "1991", "area": "中国香港", "actor": "周星驰,张敏,吴孟达,张耀扬,黄一山,秦沛,苑琼丹,陈国新", "director": "陈嘉上", "content": "<p>周星星（周星驰 饰）是飞虎队队长，奉命以卧底的身份到圣育强中学寻找警司于参观时被窃的配枪。周星星就算百般无奈还是接受了任务。他很快适应了学校的生活，功夫高强的他也受到了学校众多学生的拥戴，周星星也顺势调查失枪案件。警队的另一位卧底曹达华（吴孟达 饰）也参与了这个案件，最后也与同学一起合力，帮助周星星破获一踪大型军火贩卖案件。</p>", "episodes": [{"name": "HD中字", "url": "https://v1.wujinwsym3u8.com/wjv1/202308/20/XL8aswpsDu2/video/index.m3u8"}, {"name": "全集", "url": "https://v4.wujinwsym3u8.com/wjv4/202604/02/VaaYnDguSB95/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 23849, "title": "龙日一，你死定了", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260704-1/5f5de6deea8c313da12fa79a4a4f3d6d.jpg", "year": "2017", "area": "中国大陆", "actor": "邱赫南,侯佩杉,魏哲鸣,黄千硕,朱庭辰,贾司特,张珂源,曾丽瑶,张双利,刘玉翠,吴任远", "director": "李遥波", "content": "<p>《龙日一，你死定了》是一部校园、青春、时尚网剧。该剧主要讲述优等生张静美转校来到顶级精英学府——本承学院，却在入校第一天不幸遇到“校园魔头”龙日一。两人就在这一来一回、斗智斗勇的较量中互生情愫。他们的恋情在本承学院掀起巨大波澜，同时也让龙日一家族的关系变得微妙起来……</p>", "episodes": [{"name": "全集", "url": "https://v12.wujinwsym3u8.com/wjv12/202607/03/LUD6ffiwHU97/video/index.m3u8"}, {"name": "第01集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/jUvd3VSyXc1/video/index.m3u8"}, {"name": "第02集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/83JtT5MB821/video/index.m3u8"}, {"name": "第03集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/28/7HqDLhsXi51/video/index.m3u8"}, {"name": "第04集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/vzrB4Pv14w1/video/index.m3u8"}, {"name": "第05集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/50nCDkmpQa1/video/index.m3u8"}, {"name": "第06集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/BqbKDQDDnW1/video/index.m3u8"}, {"name": "第07集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/6An1Ff7ZJ31/video/index.m3u8"}, {"name": "第08集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/SemSJZnvGA1/video/index.m3u8"}, {"name": "第09集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/NtSXPyGUzU1/video/index.m3u8"}, {"name": "第10集", "url": "https://v4.wujinwsym3u8.com/wjv4/202308/28/L2fDCG4Cga1/video/index.m3u8"}, {"name": "第11集", "url": "https://v7.wujinwsym3u8.com/wjv7/202309/12/mnnxtMzXAe1/video/index.m3u8"}, {"name": "第12集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/cLMasGMyAw1/video/index.m3u8"}, {"name": "第13集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/8KQSdETVE21/video/index.m3u8"}, {"name": "第14集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/uqqF7DDVPa1/video/index.m3u8"}, {"name": "第15集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/Dth018sQnq1/video/index.m3u8"}, {"name": "第16集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/u3gcQMjnKC1/video/index.m3u8"}, {"name": "第17集", "url": "https://v4.wujinwsym3u8.com/wjv4/202309/04/N80VyfdhQH1/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 7905, "title": "心花路放", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260319-1/6ca769ec7f7abece7b183d5bdcbc906b.jpg", "year": "2014", "area": "内地", "actor": "黄渤,徐峥,袁泉,周冬雨,马苏", "director": "宁浩", "content": "二手音响商耿浩婚姻失败，他想用锤子爆小三的头，却迟迟没有勇气，幸亏在剧组做制片的兄弟郝义及时发现自暴自弃的耿浩，他决定带着耿浩开启一段“治愈之旅”。于是一对好基友带着一只狗上路，邂逅三千公里的“桃花”。“阿凡达女郎”、“杀马特”周丽娟、“白富美”，各式各样的女人接连登场，耿浩一路艳遇一路疗伤。时光倒转，5年前的此时，大龄文艺女青年因为听了一首流浪歌手耿浩的歌，毅然前往大理……在经历一连串奇葩遭遇之后，大家都放下了心里的“阴影”，找到了通向幸福的道路。", "episodes": [{"name": "HD中字", "url": "https://v1.wujinwsym3u8.com/wjv1/202308/19/vjyLu77j352/video/index.m3u8"}, {"name": "全集", "url": "https://v2.wujinwsym3u8.com/wjv2/202603/18/aHXdR3ML1f93/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 6982, "title": "我是外星人", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260312-1/468195dae92429b99c5898e7aed65098.jpg", "year": "2010", "area": "内地", "actor": "王筝,王向荣", "director": "赵国强,谭华", "content": "<p>《我是外星人》以一个成天喜欢幻想的小孩子天游为主角，对孩童时期的梦想附以温柔深沉的人文关怀，以音乐为核心线索，运用信天游与现代最流行音乐元素的结合，展现自由、乐观的精神追求，最终实现梦想的励志故事。\\r制片人赵国强是一位地地道道的陕西影视人，由于对黄土文化有着很深沉的情结，一直以来的梦想就是拍摄一部有关家乡，有关陕北民歌的影片。\\r其创作过程跟片名一样，也充满了惊喜。赵国强有感而发：“真是一波三折，是个很煎熬过程。但有趣的是，谭华有着深厚的音乐功底，是个难得的跨界导演，而编剧蔚灵也是个充满了童趣和梦想的人，简直是为这个剧本而生！我相信这是命运的安排”。三个人最终磨合出了现在这个充满着传统民歌与R&amp;B、摇滚等现代音乐元素的新版本。</p>", "episodes": [{"name": "HD中字", "url": "https://v1.wujinwsym3u8.com/wjv1/202308/19/WDPweuF1zy2/video/index.m3u8"}, {"name": "全集", "url": "https://v7.wujinwsym3u8.com/wjv7/202603/11/sWRW7e18Zs91/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 4550, "title": "放羊的星星", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260522-1/58bc4fb6a187cdf362c80bb322ab82c1.jpg", "year": "2007", "area": "中国台湾", "actor": "林志颖,刘荷娜,立威廉,李威,洪小玲", "director": "陈铭章", "content": "<p>替爱人顶罪刚被假释出狱的女诈欺犯夏之星（刘荷娜 饰）发现爱人竟与别的女子结婚。而E-shine集团二公子仲天骐（林志颖 饰）的旧情人要和哥哥仲天骏(立威廉 饰) 结婚。两人因天骐母亲的遗物Queen Mary相遇了，来到简朴温馨的明日乡。两个被爱情抛弃的人放下身分的隔阂，用心去相处。阿星喜欢设计珠宝，却只能靠仿冒饰品维生。天骐为圆她的梦想，参加了赌命赛车，却在一次败北当中被黑道老大废了右手，身负重伤。阿星不拖累了天骐，忍痛接受了仲父的支票离开天骐。天骏不忍拆散两人，开车要带阿星回来却半路车祸身亡。天骐自此封锁情感，性情骤变，抱着对阿星的仇恨，加倍工作，变成冷血无情的商人。　　五年后，因争取代言，天骐与阿星再度相逢，再也不能信任彼此的怨偶，却因为当初定情的一条手链“仲夏夜之星”，仍然被紧紧地牵系在一起，再度爱上彼此的两人，却只能用谎言不断包装自己的真心....</p>", "episodes": [{"name": "全集", "url": "https://v10.wujinwsym3u8.com/wjv10/202605/21/YjRAHxDhHp96/video/index.m3u8"}, {"name": "第01集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/NquptbQCmG2/video/index.m3u8"}, {"name": "第02集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/dhtXCEuXp32/video/index.m3u8"}, {"name": "第03集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/yNkxcR1p9k2/video/index.m3u8"}, {"name": "第04集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/gxzg7kJgxR2/video/index.m3u8"}, {"name": "第05集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/EXd47RUU522/video/index.m3u8"}, {"name": "第06集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/BrMvJtGpRz2/video/index.m3u8"}, {"name": "第07集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/kWnvem66dy2/video/index.m3u8"}, {"name": "第08集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/1hwgyxxaYt2/video/index.m3u8"}, {"name": "第09集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/vkTBFQ2AnJ2/video/index.m3u8"}, {"name": "第10集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/DEC0pDBxPy2/video/index.m3u8"}, {"name": "第11集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/c26ZZ4qcgt2/video/index.m3u8"}, {"name": "第12集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/LMSsFHbU5L2/video/index.m3u8"}, {"name": "第13集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/f4QX24Lwrf2/video/index.m3u8"}, {"name": "第14集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/cEEPLaUXbA2/video/index.m3u8"}, {"name": "第15集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/Uk2c8PBqTe2/video/index.m3u8"}, {"name": "第16集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/0XJRSSQg2R2/video/index.m3u8"}, {"name": "第17集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/LA1ASBcZKp2/video/index.m3u8"}, {"name": "第18集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/VXqNrLLtQq2/video/index.m3u8"}, {"name": "第19集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/FdcVc43x9E2/video/index.m3u8"}, {"name": "第20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/22/WTh25V37Tm2/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 2407, "title": "无人区", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260924-1/fc2741441066b05604962207955f7d54.jpg", "year": "2013", "area": "中国大陆", "actor": "徐峥,黄渤,余男,多布杰,王双宝,巴多,杨新鸣,郭虹,陶虹,黄精一,赵虎,王辉", "director": "宁浩", "content": "<p>小有名气但利欲熏心的律师潘肖（徐峥 饰），凭借扎实的法律知识和巧舌如簧的庭辩技巧，成功帮盗捕国家珍禽阿拉泰隼并残忍杀害一名警察的西北盗猎团伙老大（多布杰 饰）洗脱罪名。老大承诺十天后付清余款，潘肖则要求对方用一辆红色轿车抵押。在此之后，他驾驶着新车踏上从西北荒漠返回大都会的路程。谁知路上险情不断，先是和一对开卡车拉茅草的哥俩（王双宝 &amp; 巴多 饰）发生摩擦，导致人伤车损，接着又不慎撞飞一个似乎拦车求助的男子（黄渤 饰）。自知摊上人命的潘肖辗转来到一家专事不法勾当的黑店，并在此结识了受困于此的妓女（余男 饰）。与此同时，盗猎老大尾随其后，似乎另有凶险计划。　　此时潘肖还没真正意识到，他前方是怎样一条充满凶险的旅途……</p>", "episodes": [{"name": "HD中字", "url": "https://v1.wujinwsym3u8.com/wjv1/202308/19/1TcS1PXMv62/video/index.m3u8"}, {"name": "全集", "url": "https://v3.wujinwsym3u8.com/wjv3/202609/24/m8DEKeHei191/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 2134, "title": "飞越疯人院", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260726-1/30e8ef27e08ce24871c5dc4d141d8293.jpg", "year": "1975", "area": "美国", "actor": "杰克·尼科尔森,丹尼·德维托,克里斯托弗·洛伊德,路易丝·弗莱彻,威尔·萨姆森,特德·马克兰德,布拉德·道里夫,斯加特曼·克罗索斯,迈克尔·贝里曼,彼得·布罗科,穆瓦科·卡姆布卡,威廉·达尔,乔西普·艾利克,西德尼·拉斯克,凯·李,德怀特·马费尔德,路易莎·莫里茨,威廉·雷德菲尔德,菲利普·罗斯,米米·萨奇席恩,文森特·斯卡维利,米斯·斯马尔,德罗斯·V·史密斯", "director": "米洛斯·福尔曼", "content": "<p>麦克墨菲（杰克·尼科尔森 Jack Nicholson 饰）为了逃避监狱里的强制劳动，装作精神异常，被送进了精神病院，他的到来，给死气沉沉的精神病院带来了剧烈的冲击。 麦克要求看棒球比赛的电视转播，挑战了医院严格的管理制度，受到护士长拉契特（路易丝·弗莱彻 Louise Fletcher 饰）的百般阻挠；麦克带领病人出海捕鱼，振奋了他们的精神，却让院方头痛不已。院方为了惩处麦克胆大妄为、屡犯院规，决定将他永远留在疯人院。生性自由的麦克再也无法忍受疯人院的生活，他联合病友，高大的印第安人“酋长”，开始自己的计划：飞越疯人院。 本片获1975年第48届奥斯卡最佳影片，最佳男、女主角，最佳导演和最佳改编剧本五项大奖。主人公“不自由，毋宁死”的精神在当今社会仍有很大的现实意义。</p>", "episodes": [{"name": "HD中字", "url": "https://v1.wujinwsym3u8.com/wjv1/202308/20/Q4DPDqNiUS2/video/index.m3u8"}, {"name": "全集", "url": "https://v11.wujinwsym3u8.com/wjv11/202607/26/G4nMmdekwA91/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}]