v3.wujinwsym3u8.com/wjv3/202402/26/RN8RGCdhGE2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/26/c7xj4pCHXb2/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 66111, "title": "我本女王", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/26ff0aa41ba70fe416c74880f3df0aa9.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>女潔第一天上班就幫霸總賺了一百億，為了幫丈夫的公司更上一層樓，她偽裝成清潔員，沒想到.....</p>", "episodes": [{"name": "全集", "url": "https://v2.wujinwsym3u8.com/wjv2/202404/14/y07MM5x5mw74/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 66079, "title": "特种奶爸,开局萌娃带我去相亲", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/d5718911903137338900a82ea20cec60.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>世界排名第一的杀手退出江湖，本想过几天安生日子，然而他的女儿机灵古怪每日带着老爹各种相亲，各种骚操作...</p>", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/26/Hn61Rz1pXE2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/26/45QmZP9xqR2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/26/PvP9tgQyd62/video/index.m3u8"}, {"name": "61-80集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/26/URTarSFsGH2/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part118.json"}, {"id": 65972, "title": "嫉恶如仇", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/132a9886a366e17fbfe7676f12b817c4.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "", "episodes": [{"name": "1-20集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/27/KM2tix0nxV2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/27/vhcY6GZAZa2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v3.wujinwsym3u8.com/wjv3/202402/27/7yLi8C9AGn2/video/index.m3u8"}, {"name": "61集", "url": "https://v3.wujinwsym3u8.com/wjv