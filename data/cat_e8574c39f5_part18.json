[{"id": 357, "title": "全职高手第一季", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210626-1/fd2989f5a6c6d883c9c19f003b7df9f5.jpg", "year": "2017", "area": "中国大陆", "actor": "张杰,叶清,佟心竹", "director": "熊可", "content": "<p>网游荣耀中被誉为教科书级别的顶尖高手叶修，因为种种原因遭到俱乐部的驱逐，离开职业圈的他寄身于一家网吧成了一个小小的网管，但是，拥有十年游戏经验的他，在荣耀新开的第十区重新投入了游戏，带着对往昔的回忆，和一把未完成的自制武器，开始了重返巅峰之路。</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/0WjyDtGXZx1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/LzpVTYPpRX1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/3MqXUi1B3y1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/tK5ZPrHWB01/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/aL3Ccv0kEn1/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/vhJJqiPe6F1/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/ACyrCzfAAD1/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/81iUc6vVYc1/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/S1iRMZ0wsX1/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/BwXeLauLpd1/video/index.m3u8"}, {"name": "第11集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/syGM0SwmWR1/video/index.m3u8"}, {"name": "第12集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/06/83GMr1aA2f1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 295, "title": "拾忆长安·明月几时有第二季", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210626-1/cf87b45cc7f6b024c1fe5a313ea0aca9.webp", "year": "2021", "area": "国产", "actor": " 张恩泽 / 李哎 / 张震 / 黎筱濛 / 藤新 / 小连杀 / 李姗姗 / 北炎 / 李兰陵 / 陈啟刚 / 念汝 / 叮当 / 王宁 / 锦鲤 / 轻扬 / DK / slayerboom / 张远韬", "director": "肖磊", "content": "<p><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　我是李明月，我的夫君是大唐九皇子李谦。我们的结合纯粹是因大唐和汐月结盟而来的政治婚姻。我俩彼此厌恶、貌合神离，但半年相处，我们竟对对方渐生好感。然而正当我对爱情到来心生甜蜜时。新的麻烦接踵而来，我青梅竹马、视作哥哥的仆固云伺要来第三者插足。更要命的是，我发现我之前半年的种种遭遇竟都是与大唐的死敌南麓，及大唐诸皇子对未来皇位的觊觎有关……面对新的危机，我和李谦的未来会怎样？我们又将如何携手共斗那些试图拆散我们并倾覆国家的阴谋与挑战？</span></p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/wiX55zXu1r1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/QFRmrDeeG11/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/f5itZfkAVt1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/z7S4zV4JAi1/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/0Yd924tHSw1/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/7XDZK586C21/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/pi8Ka248gG1/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/GaVdBYqYv51/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/VsAvuCB4MM1/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/KiVyMwfzBy1/video/index.m3u8"}, {"name": "第11集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/7FWhBzLub71/video/index.m3u8"}, {"name": "第12集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ZALb0w6Zib1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 272, "title": "秦时明月之万里长城", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210626-1/5125b950366308556c16f9d713470d14.webp", "year": "2012", "area": "国产", "actor": "天明", "director": "沈乐平", "content": "<p><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　《秦时明月》的背景取自秦始皇统一六国到西楚霸王项羽攻陷咸阳时期，已被翻译成7国语言，发行至全球37个国家及地区。&nbsp;</span><br/><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　　《万里长城》是《秦时明月》的第四部。自从机关城崩塌，墨家势力几乎全部清除。秦帝国又回到太平盛世迷梦中。咸阳宫中的始皇一边动用无数劳工修造万里长城，一边进行着更为精密的计划。现在这个计划已经接近完成，由阴阳家协助完成的巨艇“蜃楼”已经建造完毕。它壮丽精绝的身姿浮现海平面彼端，宛如人人梦想中的 海上仙山。为了解开巨艇“蜃楼”的疑团，各家各派势力慢慢汇聚到这座平静的海边小城。此时，故事主角天明和少羽为了避开秦兵追捕，正在儒家庄园学习和生活。而接下来各种奇异事件在此地发生，小城的平静也被完全打破。“蜃楼”这巨艇即将驶往何方？&nbsp;</span><br/><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　　各家各派势力为此慢慢聚集桑海，各种奇异事件在此发生，小城的平静也被完全打破。所有的生死仇，家国恨，都将在此刻凝结......&nbsp;</span></p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/acy4H0P4sP1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/Bh8jHK1L8T1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/9kDGHkqgML1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ir6UhAxKnt1/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/14sQhU5Ui31/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/DE406cv94T1/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/nTHsxjS4z01/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/j908gnkWJP1/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/PH51sUdT2z1/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/qgS8taHQ1j1/video/index.m3u8"}, {"name": "第11集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/E9ahNVszVq1/video/index.m3u8"}, {"name": "第12集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/1HrsP2FMuK1/video/index.m3u8"}, {"name": "第13集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/WMrg3YQE4G1/video/index.m3u8"}, {"name": "第14集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/Lktwag0w2b1/video/index.m3u8"}, {"name": "第15集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/nd5gsLi8e21/video/index.m3u8"}, {"name": "第16集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/hAhtW1Dg7B1/video/index.m3u8"}, {"name": "第17集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/XyAiDXh4py1/video/index.m3u8"}, {"name": "第18集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/STK2DQQa281/video/index.m3u8"}, {"name": "第19集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ej5m9N1wPG1/video/index.m3u8"}, {"name": "第20集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/fipuU8vqyY1/video/index.m3u8"}, {"name": "第21集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/vyjh8BRMB11/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 227, "title": "一人之下第三季", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210626-1/f8329b8d1e1ec8d75e063088934d2a74.jpg", "year": "2020", "area": "中国大陆", "actor": "曹云图,小连杀,彭尧", "director": "黄成希,危天行", "content": "<p>罗天大醮之后，王也被武当除名回到了家中，却因为身怀“八奇技-风后奇门”遭人觊觎，家人遭人监视。王也万般无奈，在好友诸葛青的建议下向“哪都通”公司的求助，张楚岚携冯宝宝前来破案。张楚岚如何一展身手帮王也抓出幕后黑手？诸葛青和王也等人又将有怎样精彩的表现？觊觎“八奇技”的人究竟是谁？《一人之下-入世篇》即将揭晓！</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/t7NEFeeBU31/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/V0w6DhLN3z1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/DtPq3RKBiu1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/LXyecv6isk1/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/J32JC632b81/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/JkREFNK3mP1/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/qJ7f9E5xgW1/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/tQevLx15yC1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 226, "title": "一人之下第二季", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210626-1/754822507be13ced04de2a646255082d.jpg", "year": "2017", "area": "中国大陆", "actor": "曹云图,小连杀,彭尧", "director": "王昕,陈烨", "content": "<p>这个世界是存在异人的。刚刚接触异人世界的张楚岚，加入了管理异人的组织“哪都通”。为了解开爷爷和自身的秘密，张楚岚和冯宝宝一起前往龙虎山天师府参加异人界的盛会——罗天大醮，并与众多异人高手对战。</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/RDaax0redn1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/X0RJvqxBmM1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/QtJeyNV1C41/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/pe4nNACF5h1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 178, "title": "两不疑", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210625-1/c699b0ca9755a22cbcd6bae9e5de1b38.jpg", "year": "2021", "area": "中国大陆", "actor": "徐佳琦,张杰,苏尚卿", "director": "何振华", "content": "<p>原本相看两生厌、互不信任不会武功的文治皇帝和舞刀弄枪的武将皇后因意外互换了身体，不得不接受现实的两人，在扮演对方身份的过程中，解开了误会，学会了爱与信任。结发为夫妻，恩爱两不疑。</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/b0MNHCrqpG1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ZmXLiRTHMJ1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ZUxns6p4Ex1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/MqAKb5xEnR1/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/zJzT2QK6vR1/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ZXfFN4zQBc1/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/Zyqt6D5P9c1/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/a7MdF5E22P1/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/BuNrhZFBd41/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/Wud6gyKGyV1/video/index.m3u8"}, {"name": "第11集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/RSJ9CGZttc1/video/index.m3u8"}, {"name": "第12集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/W0bvZdJDAb1/video/index.m3u8"}, {"name": "第13集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/DkXEMVGhw21/video/index.m3u8"}, {"name": "第14集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/JQVcX2UKgQ1/video/index.m3u8"}, {"name": "第15集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/X6cYn0QBhB1/video/index.m3u8"}, {"name": "第16集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/dfPJ7x5AVY1/video/index.m3u8"}, {"name": "第17集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/0R1i9X5XJ01/video/index.m3u8"}, {"name": "第18集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/MnHsh4L5B31/video/index.m3u8"}, {"name": "第19集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/3UYTsuzNP91/video/index.m3u8"}, {"name": "第20集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/GyMSeJhWbd1/video/index.m3u8"}, {"name": "第21集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/MSUA1gFXk31/video/index.m3u8"}, {"name": "第22集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/xp3XyeXeJR1/video/index.m3u8"}, {"name": "第23集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/0aLgYwHC6G1/video/index.m3u8"}, {"name": "第24集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/WH161KKvKR1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 170, "title": "画江湖之换世门生第二季", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210625-1/0dfae5fccacd80ba8a344ad46d4720a6.jpg", "year": "2021", "area": "中国大陆", "actor": "彭尧,褚珺,白雪岑", "director": "刘阔,褚珺", "content": "<p>空间中有两个世界，一个叫元，一个叫易。两个世界的人生死相依，若一个世界的你死去，另一个世界的你也将同时死去，一个自称“解梦人”的神秘女人这样告诉元世界的念阳枭。元世界念阳枭的父亲念正元突然离世也印证了这一点，为了保护自己心慕之人——空灵慧免遭意外死亡，念阳枭毅然决然跨越两个世界的边缘来到易世界，去寻找一个身上有红色印记的女人，因为这个女人会直接导致易世界空灵慧的死亡进而直接威胁心怡之人的性命。为此，念阳枭踏入易世界获得超乎想象能力的同时，他再也无法回到回来的世界。</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/rX72GDfEAw1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/LFYCJH9XhL1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/6ytTTC0rzv1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/VA9XHpn1v41/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/ASCUc3ucrp1/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/rwV6Njbzv81/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/3B0gr0zpR51/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/MENB17VFL21/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/rXBTqeKzmG1/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/nLmtJ0dwYT1/video/index.m3u8"}, {"name": "第11集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/zcPXtYcQth1/video/index.m3u8"}, {"name": "第12集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/Ka4RyrWsnn1/video/index.m3u8"}, {"name": "第13集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/zKMDSVAAw31/video/index.m3u8"}, {"name": "第14集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/H3M8nsiY0T1/video/index.m3u8"}, {"name": "第15集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/fUZdLu8ys91/video/index.m3u8"}, {"name": "第16集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/491sUADXnE1/video/index.m3u8"}, {"name": "第17集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/f7yqYJ8dLg1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 139, "title": "西行纪之集结篇", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/ed35a62674ecfba470dd81433312a85d.jpg", "year": "2019", "area": "中国大陆", "actor": "刘北辰,沈达威,樊俊航", "director": "钟智行,麦正乐", "content": "<p>本季延续《西行纪》前一季剧情，讲述了唐三藏与师徒四人取得奇经交予天宫的十六年后，为了心中正义，再次集结成“西行小队”，重新踏上“还经”之路的故事。</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/KPqrjeXWwM1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/3xNdyB302Q1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/p8mAYffQvy1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/YXgs8By99u1/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/uGdm5aHF1n1/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/Pi4bKgZy8s1/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/VvAkkmCDE71/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/J61akaUybZ1/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/6T74Dk6mQj1/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/WUWxiiGT471/video/index.m3u8"}, {"name": "第11集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/nmuVt4XazW1/video/index.m3u8"}, {"name": "第12集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/37pwZJDcMb1/video/index.m3u8"}, {"name": "第13集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/7SgvWWvh021/video/index.m3u8"}, {"name": "第14集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/xwuvuDvqgK1/video/index.m3u8"}, {"name": "第15集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/YU5D27Bb571/video/index.m3u8"}, {"name": "第16集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/wfVAr3kwyp1/video/index.m3u8"}, {"name": "第17集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/GQGTJLH6z11/video/index.m3u8"}, {"name": "第18集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/pgRa1czHMR1/video/index.m3u8"}, {"name": "第19集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/VF18DFa8gz1/video/index.m3u8"}, {"name": "第20集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/rizYyhSiiZ1/video/index.m3u8"}, {"name": "第21集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/EA8xvUwYN01/video/index.m3u8"}, {"name": "第22集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/dkeZdyzA3T1/video/index.m3u8"}], "data_file": "cat_e8574c39f5_part18.json"}, {"id": 128, "title": "秦时明月之诸子百家", "category": "国产动漫", "pic": "https://img1.wujinwszy.vip/upload/vod/20210624-1/ccf9338869dafb7190ac62eaa56bfb3e.jpg", "year": "2010", "area": "中国大陆", "actor": "沈磊,蒋可,李敏妍", "director": "沈乐平", "content": "<p>故事发生在二千多年前的战国时期，秦始皇统一六国损兵达百万计，项燕兵败阵亡，少羽被困，高渐离、雪女、大铁锤赶来相救。兵败后，盖聂、墨家、项氏一族踏上逃亡之路。李斯进入儒家后，拜访先师荀子，荀子避而不见。同入儒家的少羽尊从法理少年老成，端木蓉由于被白凤所伤终日不醒，张良授计让天明与其对弈救木蓉。星魂对清秀的月儿产生浓厚兴趣反遭冷眼警告，月神把月儿带到东皇太一面前，东皇向她公布了自已的真实身世。少羽与天明观海时得知秦始皇要登临东海尽头的那座城市，暮色归途中又遇见流泪的石兰，交谈中少羽知道杀父仇人蒙恬来了，他该怎么办......</p>", "episodes": [{"name": "第01集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/96CwZywssX1/video/index.m3u8"}, {"name": "第02集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/90f8mx6aAK1/video/index.m3u8"}, {"name": "第03集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/130GCyvwVt1/video/index.m3u8"}, {"name": "第04集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/S6N1b7PEJH1/video/index.m3u8"}, {"name": "第05集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/72pX6GXrYi1/video/index.m3u8"}, {"name": "第06集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/1NaebVwP9X1/video/index.m3u8"}, {"name": "第07集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/yTTJW1y2Du1/video/index.m3u8"}, {"name": "第08集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/r9PDJiHLhz1/video/index.m3u8"}, {"name": "第09集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/p0BUrnpSqA1/video/index.m3u8"}, {"name": "第10集", "url": "https://v6.wujinwsym3u8.com/wjv6/202309/09/dBvNQn1nSD1/vid