ex.m3u8"}, {"name": "41-60集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/14/5ZH1VXgqTz2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/14/App3ivSpwj2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/14/yWV37rAuUR2/video/index.m3u8"}, {"name": "101-120集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/14/h4iL8nrfGg2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64872, "title": "大夏神官", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/6ceb0981845ef6289616cb867ca8f714.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>大夏神官梁不凡，无敌于世，凭一己之力镇守五年，如今外敌全灭，边疆已平！却被告知家没了，梁家竟被灭族，女儿妻子下落不明！居然还要挖我梁家祖坟，尔等是活腻歪了吗！</p>", "episodes": [{"name": "1-20集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/15/D4z7fP5xXQ2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/15/5QsiuXGmnD2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/15/YnaZp56PQi2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/15/8WRMTUAXE92/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64815, "title": "女友直播拔我氧气管", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/414418ff6c541ca9ea85c095cdffc1f4.jpg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>真龙殿主秦勿用，武力值爆表，号称九州最强战争机器！灵魂出窍来镇守遗弃之地，谁知竟被人认为是植物人！相恋十年的女友，竟要直播掐灭氧气管，原来是她早已红杏出墙，如今我高调回归！</p>", "episodes": [{"name": "1-20集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/16/Qz8QLhcU0T2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/16/ag9z8ZHdef2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/16/nas1fZ2PRG2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v10.wujinwsym3u8.com/wjv10/202403/16/26mtnBMkSb2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64655, "title": "重生以后，四个大佬哥哥狂宠我", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/ec6678632fdfbc399891fa033583d833.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/18/qazpqW6Dmf2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/18/3Ux48xYSbU2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/18/x8queTYXPQ2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/18/DZa2vLdQyY2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/18/Few11eBcCr2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64559, "title": "螭龙", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/6febf93debbe66ad0b4e36cba977bff3.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>被人鄙视的穷小子竟然是皇帝，美女争相求婚！</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/4tiWnVUcWv2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/uYdU3DY5XB2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/LuBM31fJgK2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/AhkK7QZ4Bk2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/j8er5dxwmi2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64557, "title": "无极归来", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/79021389578541aa493ce1a0df58f3d3.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>主人公紫衣大师是武林中地位最高的人物,他的武艺无人能敌。而医仙谷的宋长生也因其高超的医术声名远扬。</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/svy9GF9wRA2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/YA2psPmne42/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/wRX1mN6k6C2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/9KWAptgjK82/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/19/K38hzwQaMj2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64400, "title": "天赐战神", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/ba1d4af12811e65a03b1fc27cfd5b9be.jpeg", "year": "2023", "area": "内地", "actor": "", "director": "", "content": "<p>历练而来，成为龙帅，给父母报了仇，曾经踩过我的人就是我的垫脚石。得知妻女被蹉跎，告诉天下，我的出山就是为了她们的守护</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/21/FhzWbT1S3Q2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/21/0Q4Ce4pbSk2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/21/tNHkgYNhZ32/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/21/qNL58rCc7p2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/21/5Av9CL2PYA2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64301, "title": "老爹是神医？我怎么不知道", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/bc39d0cca4de5705edd064eb7b5ce5e3.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>神医小伙隐于都市悬壶济世，意外救下的美女居然是女总裁，无心拈花的他却被女总裁主动献身求爱，从此走上人生巅峰！</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/aWTK36ATmk2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/HW7cPzW6yv2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/Lh5V0EQwgK2/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/p2nKTUQsjc2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64300, "title": "至尊", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/bbceb37e142d1d25fc33df21ce9d089b.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>第一女战神到来寻找我拜师，我本想拒绝可她却说出师傅的信物！我给她三年时间，同时我也下山经历了卑微练！为了婚姻，我还被退婚？恢复至尊身份，重回世界巅峰！</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/gks55hKz9S2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/wdEYey6rwv2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/UeJeyv51y62/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/DaLVUdngqz2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/niAxtu55SG2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64299, "title": "烤摊老爸，竟是世界首富", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/f06061e9b2bebf0907d31311882e83ca.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>当年我没能护住爱人，我退休后也不再操心江湖上的事，拯救守护我们的小店！现在有人蹬鼻子上脸，不亮身份解决不了了，我就是世界首富！</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/BvcHMFAf052/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/Z9gb7ygMgb2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/x5cYjRxK602/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/i2DnFeW1Ph2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/hXUVSRwHxr2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64297, "title": "记忆被曝光后，全国痛哭", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/fd43b0882c002b593de4e448c299ce75.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>女儿有如此的成就，作为父亲的我倍感欣慰！十八年来，虽然你们不理解我，但我也为妳铺好了壹切！现在妳要曝光我的记忆，希望妳别再恨我了</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/gs2JJTpRzJ2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/YfBPAB4MPN2/video/index.m3u8"}, {"name": "41-60集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/FWJsu9cx472/video/index.m3u8"}, {"name": "61-80集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/Fw2hxjh68d2/video/index.m3u8"}, {"name": "81-100集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/22/QvSqFxiBgS2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64201, "title": "逆袭之我和重生男友暴虐渣渣", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/81e0f61058684ff87c3b0b62b074dbfc.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>前世被亲弟弟厌恶虐杀的他重生归来，一年后救起被弟弟弄的家破人亡濒死的她，他给了她新的身份渣新的人生，从此二人参与暴虐男渣女！</p>", "episodes": [{"name": "1-20集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/23/wREi85aWpV2/video/index.m3u8"}, {"name": "21-40集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/23/0e1pcGjpnZ2/video/index.m3u8"}, {"name": "41-65集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/23/ZzJDFcgCsN2/video/index.m3u8"}], "data_file": "cat_56eee99b15_part37.json"}, {"id": 64078, "title": "爱成不成", "category": "反转爽剧", "pic": "https://img1.wujinwszy.vip/upload/vod/20240409-1/20c560781bface27c46ba5f50d452d0e.jpg", "year": "2024", "area": "内地", "actor": "", "director": "", "content": "<p>穷小子因工作意外结识各路美女，爱情事业走上巅峰！</p>", "episodes": [{"name": "1-25集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/25/UCsfsyci8W2/video/index.m3u8"}, {"name": "26-51集", "url": "https://v11.wujinwsym3u8.com/wjv11/202403/25/ayXxKt7XdU2/video/index.m3u8"}, {"name": "52-74集", "url": "https://v11.wujinwsym3u8.com/wjv11/20