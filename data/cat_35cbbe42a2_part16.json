data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161568, "title": "我的保安身份藏不住了", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/97f6562b8f800055204209f1c8a64b6a.jpg", "year": "2026", "area": "中国大陆", "actor": "霍文琦＆陈洁蕾", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v5.wujinwsym3u8.com/wjv5/202606/28/vNSRrDaBU086/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161567, "title": "我那十年不见的发小", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/11422cdd14c8bc3b4775b0b00286e1d7.jpg", "year": "2026", "area": "中国大陆", "actor": "孔悦城＆文雨彤", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v5.wujinwsym3u8.com/wjv5/202606/28/DVcyFF8vRc95/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161565, "title": "狂龙赘婿！揽冷妻夜巡", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/029fa505f57652b77b0540346ab362ba.jpg", "year": "2026", "area": "中国大陆", "actor": "晁轩＆杨晰茹", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v6.wujinwsym3u8.com/wjv6/202606/28/EX0eNLFLhB97/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 44724, "title": "神之手", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/c41be1d16a25eabc6db225ebdcdbcc8b.jpg", "year": "2019", "area": "日本", "actor": "椎名桔平,杉本哲太,铃木砂羽,北村有起哉,星野真里,芦名星,叶山奖之,井上肇,坂井真纪,近藤正臣", "director": "兼重淳", "content": "<p>腕利きの外科医?白川泰生（椎名桔平）のもとに、21歳の古林章太郎（葉山奨之）が診察にやって来る。章太郎は肛門がんと診断され手術の後退院するが、数カ月後に転移が判明。がんが進行し悪化するにつれ耐え難い痛みに苦しみ、回復の見込みはなくなっていった。その状況に付き添っていた伯母の晶子（坂井真紀）も精神的に追い込まれ白川に安楽死の処置を懇願。白川はそれを拒否し、章太郎に寄り添い懸命に治療を行なうも、手の施しようがなくなる。そしてついに、苦悩の末、安楽死の処置を行なう。しかし章太郎の死を知った母親でジャーナリストの康代（鈴木砂羽）により白川は告発されてしまう。\r\n　　白川の行為は殺人か過失致死かと連日取り沙汰される中、すでに議論されていた安楽死法案の成立が現実味を帯びる。その背後で日本の医療改革を企てる団体、さらに反対派の医師やマスコミを使って安楽死法案の阻止を図る...</p>", "episodes": [{"name": "全集", "url": "https://v8.wujinwsym3u8.com/wjv8/202606/28/1u8e60PPz789/video/index.m3u8"}, {"name": "第01集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/85d3Nw5Y882/video/index.m3u8"}, {"name": "第02集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/c12cNNdqvm2/video/index.m3u8"}, {"name": "第03集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/rTQ4d3eYi12/video/index.m3u8"}, {"name": "第04集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/JT63xUyVkS2/video/index.m3u8"}, {"name": "第05集", "url": "https://v3.wujinwsym3u8.com/wjv3/202308/24/iPvVMJYTsx2/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161564, "title": "神级小保安的崛起之路", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/f1922485a8cd7cb2748256d156c61031.jpg", "year": "2026", "area": "中国大陆", "actor": "任志鹏＆赵文娇", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v9.wujinwsym3u8.com/wjv9/202606/28/KJKxj7JxEQ97/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161562, "title": "肆零肆：山茶花会开", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/c082b538f6683e455655230186f1fb18.jpg", "year": "2026", "area": "中国大陆", "actor": "王皓祯＆谭盐盐＆卡戎＆锦子＆刘擎＆卢鹿鹿", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v5.wujinwsym3u8.com/wjv5/202606/28/nabvf9JPLA88/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161561, "title": "赘婿神医不好惹", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/f98c844d15f3e213dad5b77b159764ac.jpg", "year": "2026", "area": "中国大陆", "actor": "张灵钰＆郭嘉铭", "director": "", "content": "", "episodes": [{"name": "全集", "url": "https://v3.wujinwsym3u8.com/wjv3/202606/28/imLW26cDSa88/video/index.m3u8"}], "data_file": "cat_35cbbe42a2_part16.json"}, {"id": 161559, "title": "都天下第一了，还要当护花侍卫", "category": "现代都市", "pic": "https://img1.wujinwszy.vip/upload/vod/20260629-1/e8d6a471d8a15a4cb0ddba86e559d443.jpg", "year": "2026", "area": "中国大陆", "actor": "陈洁蕾＆雷孙强", "director": "", "content": "", "episodes": [{"name": 